<!doctype html>
<html lang="da">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Malvagos</title>
  <style>
    * { box-sizing: border-box; }

    body {
      min-height: 100vh;
      margin: 0;
      padding: 0;
      background: #f7f6f2;
      color: #172033;
      font: 16px Arial, sans-serif;
    }

    input, button, select {
      font: inherit;
      padding: 10px;
      border: 1px solid #ccd2dc;
      border-radius: 7px;
    }

    button {
      cursor: pointer;
      background: #174ea6;
      color: white;
      border: 0;
    }

    button.secondary { background: #586579; }

    #auth {
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 16px;
    }

    .login-box {
      width: min(100%, 300px);
      padding: 14px;
      background: white;
      border: 1px solid #e8e5df;
      border-radius: 9px;
    }

    .login-box h2 {
      margin: 0 0 12px;
      font-size: 16px;
      color: #b98100;
    }

    .login-box h2 b { color: #172033; }
    .login-box h2 span { color: #d99a16; }

    #login {
      display: grid;
      gap: 6px;
    }

    #login label {
      margin-top: 3px;
      color: #666;
      font-size: 11px;
    }

    #login input {
      width: 100%;
      margin: 0;
      padding: 9px;
      border: 1px solid #e5e2dc;
      border-radius: 6px;
      font-size: 13px;
    }

    #login button {
      width: 100%;
      margin-top: 2px;
      padding: 9px;
      color: #17130a;
      background: #bf890b;
      border-radius: 6px;
      font-size: 13px;
    }

    .login-box small {
      display: block;
      margin-top: 10px;
      color: #777;
      font-size: 10px;
    }

    .app-shell {
      max-width: 1000px;
      margin: 0 auto;
      padding: 24px 16px;
    }

    .app-header {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .app-header h1 {
      margin: 0;
      font-size: 26px;
    }

    input:not(#login input), select {
      margin: 4px;
    }

    .card {
      overflow-x: auto;
      margin: 12px 0;
      padding: 18px;
      background: white;
      border-radius: 10px;
      box-shadow: 0 2px 8px #0001;
    }

    nav {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin: 16px 0;
    }

    nav button {
      background: #e4e9f1;
      color: #172033;
    }

    nav button.active {
      background: #174ea6;
      color: white;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      background: white;
    }

    th, td {
      padding: 10px;
      border-bottom: 1px solid #e4e7ec;
      text-align: left;
    }

    .row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
    }

    .muted { color: #667085; }
    .hidden { display: none !important; }

    #message {
      position: fixed;
      z-index: 2;
      top: 12px;
      left: 50%;
      transform: translateX(-50%);
      padding: 10px;
      white-space: pre-wrap;
      background: white;
      border-radius: 6px;
    }

    #message.error { color: #a11; }
    #message.success { color: #176b37; }
  </style>
</head>
<body>
  <div id="message" role="status"></div>

  <section id="auth">
    <div class="login-box">
      <h2><span>◆</span> Malvagos <b>Login</b></h2>
      <form id="login">
        <label for="email">E-mail</label>
        <input
          id="email"
          name="email"
          type="email"
          placeholder="E-mail"
          autocomplete="username"
          required
        >

        <label for="password">Adgangskode</label>
        <input
          id="password"
          name="password"
          type="password"
          placeholder="Adgangskode"
          autocomplete="current-password"
          required
        >

        <button type="submit">Log ind</button>
      </form>
      <small>Kun for ansatte.</small>
    </div>
  </section>

  <section id="app" class="hidden">
    <div class="app-shell">
      <header class="app-header">
        <h1>Malvagos</h1>
        <div class="row">
          <span id="who"></span>
          <button id="logout" class="secondary" type="button">Log ud</button>
        </div>
      </header>
      <nav id="tabs"></nav>
      <main id="content"></main>
    </div>
  </section>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script>
    // Supabase Project URL og publishable/anon key
    const SUPABASE_URL = "https://awkenudlyzexprjqpvcu.supabase.co";
    const SUPABASE_KEY = "sb_publishable_4njY-sWB9J2UTcmNmQuuDA_b5bLC4Vp";

    const db = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

    const tabs = ["Ind/ud", "Kunder", "Lager", "Handler", "Kontingent", "Medlemmer"];
    let me = null;
    let profile = null;
    let currentTab = "Ind/ud";
    let startCounter = 0;

    const $ = selector => document.querySelector(selector);

    const esc = value => String(value ?? "").replace(/[&<>"']/g, character => ({
      "&": "&",
      "<": "<",
      ">": ">",
      '"': """,
      "'": "'"
    })[character]);

    const money = value => Number(value || 0).toLocaleString("da-DK", {
      style: "currency",
      currency: "DKK"
    });

    function say(text = "", type = "error") {
      const message = $("#message");
      message.textContent = text;
      message.className = text ? type : "";
    }

    function table(headers, rows) {
      if (!rows.length) return '<p class="muted">Ingen oplysninger endnu.</p>';

      return `
        <table>
          <thead>
            <tr>${headers.map(header => `<th>${esc(header)}</th>`).join("")}</tr>
          </thead>
          <tbody>
            ${rows.map(row => `
              <tr>${row.map(value => `<td>${esc(value)}</td>`).join("")}</tr>
            `).join("")}
          </tbody>
        </table>`;
    }

    function isAdmin() {
      return profile?.role === "admin";
    }

    async function start(session) {
      const thisStart = ++startCounter;
      me = session?.user || null;
      profile = null;

      $("#auth").classList.toggle("hidden", !!me);
      $("#app").classList.toggle("hidden", !me);

      if (!me) {
        $("#content").innerHTML = "";
        $("#tabs").innerHTML = "";
        $("#who").textContent = "";
        say("");
        return;
      }

      const { data, error } = await db
        .from("profiles")
        .select("id, full_name, role")
        .eq("id", me.id)
        .maybeSingle();

      if (thisStart !== startCounter) return;

      if (error) {
        say("Kunne ikke hente din profil: " + error.message);
        return;
      }

      if (!data) {
        say("Din profil blev ikke fundet. Bed administratoren kontrollere Supabase-profiltabellen.");
        return;
      }

      profile = data;
      say("", "");

      $("#who").textContent =
        `${profile.full_name || me.email} (${isAdmin() ? "admin" : "medlem"})`;

      $("#tabs").innerHTML = tabs.map(tab => `
        <button type="button" data-tab="${esc(tab)}"
          class="${tab === currentTab ? "active" : ""}">${esc(tab)}</button>
      `).join("");

      await showTab(currentTab);
    }

    async function showTab(tab) {
      currentTab = tab;

      $("#tabs").querySelectorAll("button").forEach(button => {
        button.classList.toggle("active", button.dataset.tab === tab);
      });

      const out = $("#content");
      out.innerHTML = '<section class="card">Henter…</section>';
      say("");

      try {
        if (tab === "Ind/ud") {
          const [entriesResult, itemsResult] = await Promise.all([
            db.from("cash_entries").select("*").order("created_at", { ascending: false }),
            db.from("cash_items").select("*").eq("active", true).order("name")
          ]);

          if (entriesResult.error) throw entriesResult.error;
          if (itemsResult.error) throw itemsResult.error;

          const entries = entriesResult.data || [];
          const items = itemsResult.data || [];

          out.innerHTML = `
            <section class="card">
              <h2>Registrér ind- eller udbetaling</h2>
              <form data-form="cash" class="row">
                <select name="type">
                  <option value="ind">Ind</option>
                  <option value="ud">Ud</option>
                </select>
                <input name="description" placeholder="Hvad drejer det sig om?" required>
                <input name="amount" type="number" min="0.01" step="0.01"
                  placeholder="Beløb i kr." required>
                <button type="submit">Gem</button>
              </form>
            </section>

            ${isAdmin() ? `
              <section class="card">
                <h2>Prisliste for Ind/ud</h2>
                <form data-form="cashitem" class="row">
                  <input name="name" placeholder="Navn på ting" required>
                  <input name="price" type="number" min="0" step="0.01"
                    placeholder="Pris" required>
                  <button type="submit">Tilføj</button>
                </form>
                ${items.map(item => `
                  <div class="row">
                    <span>${esc(item.name)}</span>
                    <input id="cp-${esc(item.id)}" type="number" min="0" step="0.01"
                      value="${esc(item.price)}">
                    <button type="button" data-save-cash="${esc(item.id)}">Gem pris</button>
                  </div>
                `).join("")}
              </section>
            ` : ""}

            <section class="card">
              <h2>Ind- og udbetalinger</h2>
              ${table(["Dato", "Type", "Beskrivelse", "Beløb"],
                entries.map(entry => [
                  entry.created_at, entry.type, entry.description, money(entry.amount)
                ]))}
            </section>`;
        }

        if (tab === "Lager") {
          const { data, error } = await db
            .from("stock_items").select("*").order("name");

          if (error) throw error;

          out.innerHTML = `
            ${isAdmin() ? `
              <section class="card">
                <h2>Tilføj lagervare</h2>
                <form data-form="stock" class="row">
                  <input name="name" placeholder="Varenavn" required>
                  <input name="quantity" type="number" min="0" step="1"
                    placeholder="Antal" required>
                  <input name="price" type="number" min="0" step="0.01"
                    placeholder="Pris" required>
                  <button type="submit">Tilføj</button>
                </form>
              </section>
            ` : ""}

            <section class="card">
              <h2>Lager</h2>
              ${(data || []).length ? `
                <table>
                  <thead>
                    <tr><th>Vare</th><th>Antal</th><th>Pris</th>${isAdmin() ? "<th></th>" : ""}</tr>
                  </thead>
                  <tbody>
                    ${(data || []).map(item => `
                      <tr>
                        <td>${esc(item.name)}</td>
                        <td>${esc(item.quantity)}</td>
                        <td>${isAdmin()
                          ? `<input id="sp-${esc(item.id)}" type="number" min="0" step="0.01" value="${esc(item.price)}">`
                          : esc(money(item.price))}</td>
                        ${isAdmin()
                          ? `<td><button type="button" data-save-stock="${esc(item.id)}">Gem pris</button></td>`
                          : ""}
                      </tr>
                    `).join("")}
                  </tbody>
                </table>
              ` : '<p class="muted">Ingen oplysninger endnu.</p>'}
            </section>`;
        }

        if (tab === "Kontingent") {
          const [duesResult, peopleResult] = await Promise.all([
            db.from("dues").select("*, profiles(full_name)").order("year", { ascending: false }),
            db.from("profiles").select("id, full_name").order("full_name")
          ]);

          if (duesResult.error) throw duesResult.error;
          if (peopleResult.error) throw peopleResult.error;

          const dues = duesResult.data || [];
          const people = peopleResult.data || [];

          out.innerHTML = `
            ${isAdmin() ? `
              <section class="card">
                <h2>Registrér kontingentbetaling</h2>
                <form data-form="dues" class="row">
                  <select name="profile_id" required>
                    ${people.map(person => `
                      <option value="${esc(person.id)}">${esc(person.full_name || person.id)}</option>
                    `).join("")}
                  </select>
                  <input name="year" type="number" value="${new Date().getFullYear()}" required>
                  <input name="amount" type="number" min="0" step="0.01"
                    placeholder="Beløb" required>
                  <button type="submit">Registrér betalt</button>
                </form>
              </section>
            ` : ""}

            <section class="card">
              <h2>Kontingentoversigt</h2>
              ${table(["Medlem", "År", "Beløb", "Status", "Betalt dato"],
                dues.map(row => [
                  row.profiles?.full_name || "Medlem",
                  row.year,
                  money(row.amount),
                  row.paid ? "Betalt" : "Ubetalt",
                  row.paid_at || "—"
                ]))}
            </section>`;
        }

        if (tab === "Kunder") {
          const { data, error } = await db
            .from("customers").select("*").order("name");

          if (error) throw error;

          out.innerHTML = `
            <section class="card">
              <h2>Kunder</h2>
              ${table(["Navn", "Kontakt", "Noter"],
                (data || []).map(customer => [
                  customer.name, customer.contact || "—", customer.notes || "—"
                ]))}
              <p class="muted">Oprettelse og redigering af kunder er ikke med i denne version.</p>
            </section>`;
        }

        if (tab === "Handler") {
          const { data, error } = await db
            .from("deals")
            .select("*, customers(name)")
            .order("deal_date", { ascending: false });

          if (error) throw error;

          out.innerHTML = `
            <section class="card">
              <h2>Handler</h2>
              ${table(["Dato", "Kunde", "Beskrivelse", "Beløb"],
                (data || []).map(deal => [
                  deal.deal_date,
                  deal.customers?.name || "—",
                  deal.description,
                  money(deal.amount)
                ]))}
              <p class="muted">Oprettelse og redigering af handler er ikke med i denne version.</p>
            </section>`;
        }

        if (tab === "Medlemmer") {
          const { data, error } = await db
            .from("profiles").select("full_name, role").order("full_name");

          if (error) throw error;

          out.innerHTML = `
            <section class="card">
              <h2>Medlemmer</h2>
              ${table(["Navn", "Rolle"],
                (data || []).map(person => [
                  person.full_name || "—", person.role || "medlem"
                ]))}
            </section>`;
        }
      } catch (error) {
        say("Fejl ved indlæsning: " + (error.message || "Ukendt fejl"));
        out.innerHTML = "";
      }
    }

    document.addEventListener("click", async event => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;

      if (target.dataset.tab) {
        await showTab(target.dataset.tab);
        return;
      }

      if (target.id === "logout") {
        const { error } = await db.auth.signOut();
        if (error) say("Kunne ikke logge ud: " + error.message);
        return;
      }

      if (target.dataset.saveCash) {
        const id = target.dataset.saveCash;
        const input = document.getElementById(`cp-${id}`);
        const { error } = await db.from("cash_items")
          .update({ price: Number(input.value) })
          .eq("id", id);

        if (error) return say("Kunne ikke gemme prisen: " + error.message);
        say("Prisen er gemt.", "success");
        await showTab(currentTab);
        return;
      }

      if (target.dataset.saveStock) {
        const id = target.dataset.saveStock;
        const input = document.getElementById(`sp-${id}`);
        const { error } = await db.from("stock_items")
          .update({ price: Number(input.value) })
          .eq("id", id);

        if (error) return say("Kunne ikke gemme prisen: " + error.message);
        say("Prisen er gemt.", "success");
        await showTab(currentTab);
      }
    });

    document.addEventListener("submit", async event => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement)) return;

      event.preventDefault();
      say("");

      const values = Object.fromEntries(new FormData(form));
      let result;

      if (form.id === "login") {
        result = await db.auth.signInWithPassword({
          email: values.email,
          password: values.password
        });

        if (result.error) say("Login mislykkedes: " + result.error.message);
        return;
      }

      if (form.dataset.form === "cash") {
        result = await db.from("cash_entries").insert({
          type: values.type,
          description: values.description,
          amount: Number(values.amount),
          created_by: me.id
        });
      } else if (form.dataset.form === "cashitem") {
        result = await db.from("cash_items").insert({
          name: values.name,
          price: Number(values.price)
        });
      } else if (form.dataset.form === "stock") {
        result = await db.from("stock_items").insert({
          name: values.name,
          quantity: Number(values.quantity),
          price: Number(values.price)
        });
      } else if (form.dataset.form === "dues") {
        result = await db.from("dues").upsert({
          profile_id: values.profile_id,
          year: Number(values.year),
          amount: Number(values.amount),
          paid: true,
          paid_at: new Date().toISOString()
        }, { onConflict: "profile_id,year" });
      }

      if (result?.error) {
        say("Kunne ikke gemme: " + result.error.message);
        return;
      }

      if (form.dataset.form) {
        say("Gemt.", "success");
        form.reset();
        await showTab(currentTab);
      }
    });

    db.auth.onAuthStateChange((_event, session) => {
      // Vent med Supabase-forespørgslen, til auth-callbacken er afsluttet.
      setTimeout(() => start(session), 0);
    });

    db.auth.getSession().then(({ data, error }) => {
      if (error) say("Kunne ikke kontrollere login: " + error.message);
      else start(data.session);
    });
  </script>
</body>
</html>
